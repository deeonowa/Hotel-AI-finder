# Список переменных без значений. Скопируйте в .env и заполните; .env в git не попадает (он в .gitignore).
# Ключ для жюри передан организаторам в зашифрованном виде: secrets.env.age (age, публичный ключ организаторов).
# Расшифровка: age -d -i <закрытый_ключ> -o .env secrets.env.age
# Любую переменную можно оставить пустой — тогда берётся значение по умолчанию (указано в комментарии).
# Без LLM_MODEL агент работает в режиме правил и всё равно проходит весь сценарий.

# --- LLM: любой OpenAI-совместимый провайдер. Наш: OpenRouter ---
# Адрес API провайдера: https://openrouter.ai/api/v1
#   (Ollama в docker compose --profile local: http://ollama:11434/v1)
LLM_BASE_URL=
# Ключ провайдера LLM (для жюри — отдельный ключ OpenRouter: https://openrouter.ai/settings/keys)
LLM_API_KEY=
# Модель: nvidia/nemotron-3.5-super-vl:free (Ollama: qwen2.5:7b-instruct)
LLM_MODEL=
# Доп. параметры запроса, JSON. Для OpenRouter отключаем «размышления» (3.3 с → 0.9 с на ход):
#   {"reasoning": {"enabled": false}}
#   локальный Qwen3 (llama.cpp / LM Studio): {"chat_template_kwargs": {"enable_thinking": false}}
LLM_EXTRA_BODY=

# Надёжность LLM: таймаут запроса, с (20); сколько секунд после сбоя работать только на правилах (60);
# ниже какой уверенности модели ответ не применяется и берутся правила (0.5)
LLM_TIMEOUT_S=
LLM_COOLDOWN_S=
LLM_MIN_CONFIDENCE=

# --- Агент ---
# auto (по умолчанию) = LLM, если задан LLM_MODEL; rules = без LLM; llm = только LLM
AGENT_MODE=
# Город по умолчанию, если пользователь его не назвал (sochi): sochi, antalya, dubai, phuket, tbilisi
LOCATION_ID=

# --- Запуск ---
# Порт приложения в docker compose (8000)
APP_PORT=
# База данных: в docker compose задаётся автоматически (сервис postgres).
# Для запуска без Docker: postgresql://trip:trip@localhost:5432/trip_agent; memory:// — без БД
DATABASE_URL=
