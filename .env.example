# Скопируйте в .env и заполните. .env НИКОГДА не коммитится (он в .gitignore).
# Без LLM_MODEL агент работает в режиме правил (rules) — всё равно проходит весь сценарий.

# --- Вариант A: OpenRouter (любая модель с хорошим JSON, напр. Qwen) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=qwen/qwen-2.5-72b-instruct

# --- Вариант B: локально через Ollama (docker compose --profile local up) ---
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b-instruct

# --- Вариант C: любой OpenAI-совместимый endpoint (vLLM, LM Studio, свой сервер) ---
# LLM_BASE_URL=http://localhost:8001/v1
# LLM_MODEL=...

# Надёжность LLM (значения по умолчанию): таймаут запроса; сколько секунд после сбоя работать только на правилах;
# ниже какой уверенности модели ответ не применяется (берутся правила)
# LLM_TIMEOUT_S=20
# LLM_COOLDOWN_S=60
# LLM_MIN_CONFIDENCE=0.5

# auto = LLM, если задан LLM_MODEL; rules = принудительно без LLM; llm = только LLM
AGENT_MODE=auto
# Город по умолчанию (если пользователь его не назвал). Доступны все папки data/locations/:
# sochi, antalya, dubai, phuket, tbilisi. Ограничить список: LOCATION_IDS=["sochi","antalya"]
LOCATION_ID=sochi

# --- База данных (Postgres) ---
# В docker compose задаётся автоматически (сервис postgres); для локального запуска без Docker:
# DATABASE_URL=postgresql://trip:trip@localhost:5432/trip_agent
# memory:// — без БД (eval, экспорт OpenAPI); состояние теряется при перезапуске
# Тесты хранилища: TEST_DATABASE_URL=postgresql://trip:trip@localhost:5432/trip_agent
